<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_designer" model="ir.actions.client">
        <field name="name">Report Designer</field>
        <field name="tag">nc_report_designer.designer</field>
    </record>

    <menuitem id="menu_report_designer_root"
              name="Report Designer"
              action="action_report_designer"
              web_icon="nc_report_designer,static/description/icon.png"
              groups="base.group_system"
              sequence="90"/>

    <record id="act_report_xml_view_designer" model="ir.ui.view">
        <field name="name">ir.actions.report.form.designer</field>
        <field name="model">ir.actions.report</field>
        <field name="inherit_id" ref="base.act_report_xml_view"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_open_report_designer" type="object"
                        invisible="report_type not in ['qweb-pdf', 'qweb-html']"
                        icon="fa-paint-brush" class="oe_stat_button">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text">Report Designer</span>
                    </div>
                </button>
            </div>
        </field>
    </record>

    <record id="res_config_settings_view_form_designer" model="ir.ui.view">
        <field name="name">res.config.settings.form.report.designer</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='document_layout_setting']/div[hasclass('content-group')]/button[1]" position="after">
                <br/>
                <button name="%(nc_report_designer.action_report_designer)d" string="Report Designer"
                        type="action" class="oe_link" icon="oi-arrow-right" groups="base.group_system"/>
            </xpath>
        </field>
    </record>
</odoo>
